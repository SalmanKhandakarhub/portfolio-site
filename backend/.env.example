# ---- SMTP -----------------------------------------------------------
# Gmail: turn on 2-factor auth, then create an App Password.
# Your normal Google password will NOT work here.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_STARTTLS=true

# ---- Addresses ------------------------------------------------------
# FROM_EMAIL must be an address this SMTP account may send as.
# With Gmail that means SMTP_USER itself, or a verified alias.
FROM_EMAIL=you@gmail.com
FROM_NAME=Salman
INBOX_EMAIL=you@gmail.com

# ---- Site -----------------------------------------------------------
SITE_NAME=salman.dev
SITE_URL=https://salman.dev
ALLOWED_ORIGINS=https://salman.dev,https://www.salman.dev,http://localhost:5500

# ---- Abuse control --------------------------------------------------
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_MAX=3
RATE_LIMIT_WINDOW=3600
